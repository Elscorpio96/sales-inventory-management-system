# Server configuration (server/). Copy to .env or set in your process manager.
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
DB_PATH=./data/inventory.db
# REQUIRED in production: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
BUSINESS_NAME=Demo Supermarket
SESSION_HOURS=12
# 1 when behind a reverse proxy (Nginx, Caddy, Render, Railway)
TRUST_PROXY=0
# Reports group sales by local day — set the server time zone
TZ=Africa/Lagos
